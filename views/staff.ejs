<%- include('partials/header') %>
<h1>Staff accounts</h1>
<div class="two-col wide-left">
  <table class="grid">
    <caption class="sr-only">Staff and manager accounts</caption>
    <thead><tr><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Created</th></tr></thead>
    <tbody>
    <% accounts.forEach(function (a) { %>
      <tr><td><%= a.first_name %> <%= a.last_name %></td><td><%= a.email %></td><td><%= a.role %></td><td><%= a.created_at.slice(0, 10) %></td></tr>
    <% }) %>
    </tbody>
  </table>
  <section class="card">
    <h2>Create a staff account</h2>
    <p class="hint">Staff and manager accounts can only be created here, never through public sign-up.</p>
    <%- include('partials/errors', { errors }) %>
    <form method="post" action="/manager/staff" novalidate>
      <div class="row">
        <div><label for="first_name">First name</label><input id="first_name" name="first_name" value="<%= values.first_name || '' %>" required></div>
        <div><label for="last_name">Last name</label><input id="last_name" name="last_name" value="<%= values.last_name || '' %>" required></div>
      </div>
      <label for="email">Email</label><input id="email" name="email" type="email" value="<%= values.email || '' %>" required>
      <label for="password">Temporary password</label><input id="password" name="password" type="password" minlength="8" required>
      <label for="role">Role</label>
      <select id="role" name="role"><option value="staff" <%= values.role !== 'manager' ? 'selected' : '' %>>Staff</option><option value="manager" <%= values.role === 'manager' ? 'selected' : '' %>>Manager</option></select>
      <button class="btn" type="submit">Create account</button>
    </form>
  </section>
</div>
<%- include('partials/footer') %>
