<%- include('partials/header') %>
<section class="card narrow">
  <h1><%= isNew ? 'Add a car' : 'Edit ' + (car.plate || 'car') %></h1>
  <%- include('partials/errors', { errors }) %>
  <form method="post" action="<%= isNew ? '/staff/fleet/new' : '/staff/fleet/' + car.id + '/edit' %>" novalidate>
    <div class="row">
      <div><label for="plate">Plate</label><input id="plate" name="plate" value="<%= car.plate || '' %>" required></div>
      <div><label for="year">Year</label><input id="year" name="year" type="number" value="<%= car.year || '' %>" required></div>
    </div>
    <div class="row">
      <div><label for="make">Make</label><input id="make" name="make" value="<%= car.make || '' %>" required></div>
      <div><label for="model">Model</label><input id="model" name="model" value="<%= car.model || '' %>" required></div>
    </div>
    <div class="row">
      <div><label for="category">Category</label>
        <select id="category" name="category" required><option value="">Choose…</option>
        <% categories.forEach(function (c) { %><option <%= car.category === c ? 'selected' : '' %>><%= c %></option><% }) %></select></div>
      <div><label for="transmission">Transmission</label>
        <select id="transmission" name="transmission" required><option value="">Choose…</option>
        <% transmissions.forEach(function (t) { %><option <%= car.transmission === t ? 'selected' : '' %>><%= t %></option><% }) %></select></div>
    </div>
    <div class="row">
      <div><label for="seats">Seats</label><input id="seats" name="seats" type="number" value="<%= car.seats || '' %>" required></div>
      <div><label for="daily_rate">Daily rate ($)</label><input id="daily_rate" name="daily_rate" type="number" step="0.01" value="<%= car.daily_rate || '' %>" required></div>
    </div>
    <label for="location_id">Location</label>
    <select id="location_id" name="location_id" required><option value="">Choose…</option>
    <% locations.forEach(function (l) { %><option value="<%= l.id %>" <%= Number(car.location_id) === l.id ? 'selected' : '' %>><%= l.name %></option><% }) %></select>
    <button class="btn" type="submit"><%= isNew ? 'Add car' : 'Save changes' %></button>
    <a class="link" href="/staff/fleet">Cancel</a>
  </form>
</section>
<%- include('partials/footer') %>
