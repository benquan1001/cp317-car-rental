<%- include('partials/header') %>
<div class="two-col">
  <section class="card">
    <h1>Log in</h1>
    <% if (error) { %><p class="errors" role="alert"><%= error %></p><% } %>
    <form method="post" action="/login" novalidate>
      <input type="hidden" name="next" value="<%= next %>">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="username" value="<%= email %>" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit" class="btn">Log in</button>
    </form>
    <p class="hint">Customers, staff, and managers all log in here. Each role lands on its own home page.</p>
  </section>
  <section class="card">
    <h2>New customer?</h2>
    <p>Create an account to search for cars and, from Sprint 2, make reservations.</p>
    <a class="btn secondary" href="/register">Create an account</a>
  </section>
</div>
<%- include('partials/footer') %>
